{
  "name": "salam-residences",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node pack.mjs",
    "preview": "vite preview",
    "pack": "node pack.mjs",
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "start": "node server.mjs",
    "legacy": "node server.mjs",
    "db:health": "node -e \"import('./db/sqlite.mjs').then(m=>{m.openDatabase();console.log(JSON.stringify(m.health(),null,2));})\"",
    "check": "node --test tests/**/*.test.js && vite build && node pack.mjs"
  },
  "dependencies": {
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
